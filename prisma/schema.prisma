generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  company   Company? @relation(fields: [companyId], references: [id])
  companyId String?
  feedbacks Feedback[]
  messages  Message[]
  reports   Report[]
  createdAt DateTime @default(now())
}

model Company {
  id        String    @id @default(cuid())
  name      String
  industry  Industry? @relation(fields: [industryId], references: [id])
  industryId String?
  users     User[]
  videos    Video[]
  reports   Report[]
  topCandidates TopCandidate[]
}

model Industry {
  id       String    @id @default(cuid())
  name     String    @unique
  companies Company[]
}

model Video {
  id        String   @id @default(cuid())
  title     String
  url       String
  company   Company? @relation(fields: [companyId], references: [id])
  companyId String?
  createdAt DateTime @default(now())
}

model TopCandidate {
  id        String   @id @default(cuid())
  name      String
  company   Company  @relation(fields: [companyId], references: [id])
  companyId String
  videoUrl  String
  createdAt DateTime @default(now())
}

model Feedback {
  id        String   @id @default(cuid())
  content   String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  createdAt DateTime @default(now())
}

model Report {
  id        String   @id @default(cuid())
  reason    String
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  company   Company? @relation(fields: [companyId], references: [id])
  companyId String?
  createdAt DateTime @default(now())
}

model Message {
  id        String   @id @default(cuid())
  content   String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  createdAt DateTime @default(now())
}

model Admin {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
}